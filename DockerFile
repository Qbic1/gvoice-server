# ── Build stage ──────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build

COPY GVoice.API/GVoice.API.csproj GVoice.API/
RUN dotnet restore GVoice.API/GVoice.API.csproj

COPY . .
WORKDIR /GVoice.API
RUN dotnet publish -c Release -o /out

# ── Runtime stage ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine
WORKDIR /app
COPY --from=build /out .

ENV ASPNETCORE_URLS=http://+:5293
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 5293
ENTRYPOINT ["dotnet", "GVoice.API.dll"]