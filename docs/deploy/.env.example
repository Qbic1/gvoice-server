# Copy to `.env` at the deploy root. docker-compose reads it automatically.
# Never commit the real .env.

# Shared admin password gating room creation (CreateRoom hub method + POST /api/admin/verify).
GVOICE_ADMIN_PASSWORD=change-me-to-a-long-random-secret

# The TURN credential is NOT set here — it is compiled into the Angular bundle at
# build time. Either edit client/src/environments/environment.ts before building,
# or pass it as a build-arg (see Dockerfile) and coordinate it with coturn's
# static credential in coturn/turnserver.conf.
