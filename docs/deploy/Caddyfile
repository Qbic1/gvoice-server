# Reference Caddyfile — lives at the deploy root, mounted into the caddy container
# at /etc/caddy/Caddyfile. Replace the site address with your domain, or keep the
# global block if you terminate TLS with your own certificates.
#
# TLS: this deployment uses operator-provided certificates mounted at /etc/certs.
# To use automatic Let's Encrypt instead, replace the `tls` line with your email
# in a global options block and expose port 80 for the ACME challenge.

voice-room.ru {
	tls /etc/certs/certificate_fullchain.crt /etc/certs/certificate.key

	# ── API + SignalR ────────────────────────────────────────
	# The client calls /api/hub/signaling and /api/rooms; the backend maps them at
	# /hub/signaling and /rooms (no /api prefix), so we MUST strip it here.
	# reverse_proxy transparently proxies the WebSocket upgrade used by SignalR.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:5293 {
			# SignalR WebSockets require HTTP/1.1 to the backend.
			transport http {
				versions 1.1
			}
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Port {server_port}
		}
	}

	# ── Angular static SPA ───────────────────────────────────
	handle {
		root * /srv/www

		# HTML must never be cached — it references hashed asset filenames.
		@all_html path *.html
		header @all_html Cache-Control "no-cache, no-store, must-revalidate"

		# Hashed static assets are immutable and can be cached for a year.
		@static path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff2 *.woff *.ttf
		header @static Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
